# Documentation only. Local preview reads ignored .dev.vars.
QLOO_API_KEY=
# Server-only maintenance key for bulk catalog writes. Never expose in browser code.
CATALOG_ADMIN_TOKEN=
# Personal Fever OAuth: registered callback must match the hosted private Site.
FEVER_OAUTH_CLIENT_ID=
FEVER_OAUTH_CLIENT_SECRET=
FEVER_OAUTH_REDIRECT_URI=
# Generate 32 random bytes encoded as base64url; keep the same key across deploys.
FEVER_SESSION_KEY=

# Optional self-hosted PullMD HTTPS base URL; leave blank for the direct reader.
PULLMD_URL=
# Only if your instance accepts a bearer credential. Server-side, never browser code.
PULLMD_BEARER_TOKEN=
