  "narrative": {
    "donts": [
      "**Don't** turn each result into a shadowed card; the built result pattern is an open ruled list.",
      "**Don't** use atmospheric or invented venue photography as evidence for a result.",
      "**Don't** promote the small decorative compass lettering into a reading-text style."
    ],
    "rules": [
      {
        "section": "colors",
        "name": "The Ink Role Rule",
        "body": "Use red to signal an action or editorial emphasis; use moss to show selection and supporting orientation."
      },
      {
        "section": "typography",
        "name": "The Evidence Legibility Rule",
        "body": "Keep source, detail and result metadata text at least 12px; the final stylesheet overrides earlier smaller declarations."
      },
      {
        "section": "layout",
        "name": "The Choice Before Search Rule",
        "body": "The discovery mode must remain available before mobile submission."
      }
    ],
    "keyCharacteristics": [
      "Paper background with restrained red actions and moss selection states.",
      "Oversized serif headlines paired with compact sans-serif controls.",
      "Open numbered result rows with inline source and evidence details.",
      "A desktop sidebar that becomes an inline mobile form."
    ],
    "dos": [
      "**Do** preserve the paper canvas, serif headlines and open ruled result index.",
      "**Do** keep the discovery dial before the mobile submission action.",
      "**Do** retain visible focus and minimum-40px compact action targets.",
      "**Do** keep source, detail and result metadata text at least 12px.",
      "**Do** respect reduced-motion preferences."
    ],
    "northStar": "Pocket City Field Guide",
    "overview": "Warm paper, red ink and an editorial serif make discovery feel like consulting an independent city guide. Practical sans-serif controls and open ruled results keep the experience useful when planning a visit. The compass connects familiar interests with a wider cultural radius; it is a functional geometric diagram rather than venue imagery.\n\nThis records the direct-code implementation in `app/globals.css` and `app/page.tsx`, including its final cascade overrides. No approved visual comp exists. The named direction comes from `.impeccable/direction.md`; implementation values take precedence over the direction's intentions."
  }
